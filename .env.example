# Optional overrides for the local Docker Compose stack.
FRONTEND_PORT=4200
BACKEND_PORT=8000
POSTGRES_PORT_FORWARD=5432
REDIS_PORT_FORWARD=6379

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
SECRET_KEY=local-development-only-change-me

# Required before running `python -m scripts.setup_initial_data`.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-local-password

# Profile images: 5 MiB input and at most 4096 px on either side.
PROFILE_IMAGE_MAX_BYTES=5242880
PROFILE_IMAGE_MAX_DIMENSION=4096

# Feature toggles used by the backend container.
BACKEND_ENVIRONMENT=development
BACKEND_DEBUG=true
CREATE_TABLES_ON_STARTUP=true
CACHE_ENABLED=true
DASHBOARD_CACHE_TTL_SECONDS=300
RATE_LIMITER_ENABLED=true
TASKIQ_ENABLED=true

# Optional SonarQube profile (`docker compose --profile sonar ...`).
SONAR_PORT=9000
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar
SONAR_DB_NAME=sonarqube
# Generate a project token in SonarQube before running the scanner:
# SONAR_TOKEN=token_do_sonar
# One-shot Material Scrap simulation (`docker compose --profile simulation up`).
# Set HANARO_API_KEY to a key with material_scrap:create to send the batch.
# Defaults to the anonymized fixture. On Windows, use e.g.
# HANARO_SIMULATION_HOST_INPUT_DIR=C:/Users/User/Downloads
# HANARO_SIMULATION_INPUT=/input/Other_Account_Transaction_Text_250826_
HANARO_SIMULATION_HOST_INPUT_DIR=./automation/fixtures
HANARO_SIMULATION_INPUT=/input/Other_Account_Transaction_Text_anonymized
HANARO_SIMULATION_REFERENCE_DATE=2026-08-26
HANARO_SIMULATION_EXCHANGE_RATE=5.15
HANARO_SIMULATION_RATE_SOURCE=manual_fixture
HANARO_SIMULATION_SEND=true
HANARO_API_KEY=

#script de criar usuario
ADMIN_NAME=messyas
ADMIN_EMAIL=messyasgoisfranca@gmail.com
ADMIN_USERNAME=takana
ADMIN_PASSWORD=23122003Ms@@
