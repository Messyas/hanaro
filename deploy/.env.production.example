# Copy to deploy/.env.production and replace every required value.
PUBLIC_HOST=dashboard.factory.example
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_USER=dashboard_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=dashboard
REDIS_PASSWORD=replace-with-a-strong-redis-password
SECRET_KEY=replace-with-at-least-32-random-characters

# Personalized sessions may remain active for one work shift.
SESSION_TIMEOUT_MINUTES=720
MAX_SESSIONS_PER_USER=5
