@startuml
title Hanaro - arquitetura geral do dashboard de Material Scrap

left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam componentStyle rectangle

actor "Analista / Modo TV" as Reader
actor "Administrador" as Admin

rectangle "Mesma origem HTTPS" {
  component "Frontend Angular\napenas apresentação" as Frontend
  component "FastAPI routes\ncontratos + autorização" as Routes
}

package "Aplicação Material Scrap" {
  component "IngestionService\nreconciliação e transação" as Ingestion
  component "ProjectionBuilder\npré-cálculo" as Builder
  component "ScrapDashboardService\nKPIs, séries e rankings" as Dashboard
  component "ScrapTargetService\nmetas mensais" as TargetService
  component "DashboardResponseCache\nchave versionada + TTL" as ResponseCache
}

queue "Redis DB 3\nTaskiq" as Queue
database "PostgreSQL\ntransações (write model)" as Transactions
database "PostgreSQL\nagregados + metas + revisão\n(read model)" as ReadModel
database "Redis DB 0\ncache de resposta" as Cache

Reader --> Frontend
Frontend --> Routes : GET /api/v1/dashboard/scrap
Admin --> Routes : PUT /targets\nsessão + CSRF + superusuário
Routes --> Queue : ingestão com API key
Queue --> Ingestion
Ingestion --> Builder
Ingestion --> Transactions : commit atômico
Builder --> ReadModel : commit atômico
Routes --> Dashboard
Routes --> TargetService
Dashboard --> ResponseCache
ResponseCache --> Cache
Dashboard --> ReadModel : cache miss
TargetService --> ReadModel : upsert + nova revisão

note bottom of Dashboard
  Nenhum SUM sobre scrap_transactions
  ocorre durante a requisição do dashboard.
end note

note bottom of ResponseCache
  Cache indisponível: bypass para o read model.
  Autorização nunca depende do cache.
end note
@enduml
